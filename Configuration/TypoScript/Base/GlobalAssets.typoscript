# ─────────────────────────────────────────────
# Global assets loaded on every page when
# conn_elements is active in the project.
# ─────────────────────────────────────────────

page.includeCSS {
    conn_elements_text_animation = EXT:conn_elements/Resources/Public/Css/text-animation.css
}

page.includeJSFooter {
    conn_elements_text_animation = EXT:conn_elements/Resources/Public/Js/components/text-animation.js
    conn_elements_text_animation.type = module
}

# Extend lib.contentElement with conn_elements paths.
# Note: fluid_styled_content CEs use =< lib.contentElement at parse-time (before this
# Set loads), so layoutRootPaths.20 set here does NOT reach those copies.
# We therefore also set layoutRootPaths.20 directly on each standard CType below.
lib.contentElement {
    templateRootPaths.20 = EXT:conn_elements/Resources/Private/Templates/ContentElements/
    partialRootPaths.20 = EXT:conn_elements/Resources/Private/Partials/
    layoutRootPaths.20 = EXT:conn_elements/Resources/Private/Layouts/
}

# Directly add conn_elements layout to standard fluid_styled_content CEs so they
# render with data-text-animation on their frame div.
tt_content.text.layoutRootPaths.20 = EXT:conn_elements/Resources/Private/Layouts/
tt_content.textpic.layoutRootPaths.20 = EXT:conn_elements/Resources/Private/Layouts/
tt_content.textmedia.layoutRootPaths.20 = EXT:conn_elements/Resources/Private/Layouts/
tt_content.image.layoutRootPaths.20 = EXT:conn_elements/Resources/Private/Layouts/
tt_content.header.layoutRootPaths.20 = EXT:conn_elements/Resources/Private/Layouts/
tt_content.html.layoutRootPaths.20 = EXT:conn_elements/Resources/Private/Layouts/
tt_content.bullets.layoutRootPaths.20 = EXT:conn_elements/Resources/Private/Layouts/
tt_content.table.layoutRootPaths.20 = EXT:conn_elements/Resources/Private/Layouts/
tt_content.uploads.layoutRootPaths.20 = EXT:conn_elements/Resources/Private/Layouts/
tt_content.shortcut.layoutRootPaths.20 = EXT:conn_elements/Resources/Private/Layouts/
tt_content.div.layoutRootPaths.20 = EXT:conn_elements/Resources/Private/Layouts/

# Base object for every conn_elements CE.
# Extends lib.contentElement and sets all three path indices (0, 10, 20) directly,
# so any CE that copies this object gets the correct paths without repeating them.
lib.conn_elements_ce =< lib.contentElement
lib.conn_elements_ce {
    templateRootPaths.20 = EXT:conn_elements/Resources/Private/Templates/ContentElements/
    partialRootPaths.20 = EXT:conn_elements/Resources/Private/Partials/
    layoutRootPaths.20 = EXT:conn_elements/Resources/Private/Layouts/

    # conn_base's ContentElements/Default.html adds the Appearance-tab background
    # feature (color/image, cover/contain/parallax) on top of this same frame markup.
    # Set at a higher priority than .20 above so it wins for every custom conn_elements
    # CE (Logo Wall, Card Group, sliders, …) that copies this object below — including
    # any added later, since they all inherit from this single definition.
    layoutRootPaths.30 = EXT:conn_base/Resources/Private/Layouts/ContentElements/
    # That layout renders a shared header partial from conn_base — needs to be
    # resolvable too.
    partialRootPaths.30 = EXT:conn_base/Resources/Private/Partials/
}
