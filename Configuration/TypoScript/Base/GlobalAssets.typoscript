# ─────────────────────────────────────────────
# Global assets for conn_t3wtk_elements.
# Text-animation CSS/JS is NOT included here: it is collected on demand via
# f:asset.css / f:asset.script in Partials/ContentElements/FrameAttributes.html
# whenever an element actually has a text animation set.
# ─────────────────────────────────────────────

# Extend lib.contentElement with conn_t3wtk_elements paths.
# Path layering: fluid_styled_content (0/10) < conn_t3wtk_base (30) < conn_t3wtk_elements (40)
# < sitepackage (50) — higher index wins for same-named Fluid files.
# Index 40 lets conn_t3wtk_elements override conn_t3wtk_base partials, in particular
# ContentElements/FrameAttributes.html (the frame-div attribute hook rendered by
# conn_t3wtk_base's ContentElements/Default.html layout), which adds
# data-text-animation to every frame div.
lib.contentElement {
    templateRootPaths.40 = EXT:conn_t3wtk_elements/Resources/Private/Templates/ContentElements/
    partialRootPaths.40 = EXT:conn_t3wtk_elements/Resources/Private/Partials/
    layoutRootPaths.40 = EXT:conn_t3wtk_elements/Resources/Private/Layouts/
}

# Note: fluid_styled_content CEs use =< lib.contentElement at parse-time (before
# this Set loads), so paths set above do NOT reach those copies. We therefore
# also register the partial path directly on each standard CType, so the
# FrameAttributes override (text animation) works for them too.
tt_content.text.partialRootPaths.40 = EXT:conn_t3wtk_elements/Resources/Private/Partials/
tt_content.textpic.partialRootPaths.40 = EXT:conn_t3wtk_elements/Resources/Private/Partials/
tt_content.textmedia.partialRootPaths.40 = EXT:conn_t3wtk_elements/Resources/Private/Partials/
tt_content.image.partialRootPaths.40 = EXT:conn_t3wtk_elements/Resources/Private/Partials/
tt_content.header.partialRootPaths.40 = EXT:conn_t3wtk_elements/Resources/Private/Partials/
tt_content.html.partialRootPaths.40 = EXT:conn_t3wtk_elements/Resources/Private/Partials/
tt_content.bullets.partialRootPaths.40 = EXT:conn_t3wtk_elements/Resources/Private/Partials/
tt_content.table.partialRootPaths.40 = EXT:conn_t3wtk_elements/Resources/Private/Partials/
tt_content.uploads.partialRootPaths.40 = EXT:conn_t3wtk_elements/Resources/Private/Partials/
tt_content.shortcut.partialRootPaths.40 = EXT:conn_t3wtk_elements/Resources/Private/Partials/
tt_content.div.partialRootPaths.40 = EXT:conn_t3wtk_elements/Resources/Private/Partials/

# Base object for every conn_t3wtk_elements CE.
# Extends lib.contentElement and sets all conn paths directly, so any CE that
# copies this object gets the correct paths without repeating them.
lib.conn_t3wtk_elements_ce =< lib.contentElement
lib.conn_t3wtk_elements_ce {
    # Parse-time copy: the =< reference above does not deliver lib.contentElement's
    # settings to the CEs at render time (same reason the path indexes are set
    # directly here) — without this, {settings.*} is empty in Fluid for all
    # conn_t3wtk_elements CEs (e.g. defaultHeaderType, media.popup/lightbox config).
    settings < lib.contentElement.settings

    templateRootPaths.40 = EXT:conn_t3wtk_elements/Resources/Private/Templates/ContentElements/
    partialRootPaths.40 = EXT:conn_t3wtk_elements/Resources/Private/Partials/
    layoutRootPaths.40 = EXT:conn_t3wtk_elements/Resources/Private/Layouts/

    # conn_t3wtk_base's ContentElements/Default.html adds the Appearance-tab background
    # feature (color/image, cover/contain/parallax) on top of this same frame markup.
    # Registered here so it wins for every custom conn_t3wtk_elements CE (Logo Wall,
    # Card Group, sliders, …) that copies this object below — including any added
    # later, since they all inherit from this single definition.
    layoutRootPaths.30 = EXT:conn_t3wtk_base/Resources/Private/Layouts/ContentElements/
    # That layout renders shared partials from conn_t3wtk_base (HeaderSwitch,
    # FrameAttributes default) — need to be resolvable too.
    partialRootPaths.30 = EXT:conn_t3wtk_base/Resources/Private/Partials/
}
