# ─────────────────────────────────────────────
# Map & Location Content Element – conn_t3kit_elements
# ─────────────────────────────────────────────

tt_content.conn_map =< lib.conn_t3kit_elements_ce
tt_content.conn_map {
    templateName = Map
    dataProcessing {
        # ContactAwareSettingsProcessor = FlexFormSettingsProcessor plus
        # settings.contact.* (for Partials/ContactInfo/Panel.html), read
        # directly from Site Settings — see the processor's docblock.
        10 = Connetation\T3kitElements\DataProcessing\ContactAwareSettingsProcessor
        10 {
            fieldName = tx_conn_t3kit_elements_map_settings
        }
    }
}
