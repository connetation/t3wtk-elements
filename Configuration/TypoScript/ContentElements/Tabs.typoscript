tt_content.conn_bs_tabs =< lib.conn_elements_ce
tt_content.conn_bs_tabs {
    templateName = Tabs
    dataProcessing {
        10 = Connetation\Elements\DataProcessing\TabItemsProcessor
        10 {
            as = items
        }
    }
}
