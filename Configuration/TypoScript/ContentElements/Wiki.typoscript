# ─────────────────────────────────────────────
# Wiki Content Element – conn_elements
# ─────────────────────────────────────────────

# Assets are registered per-template via f:asset.script / f:asset.style
# (loaded only on pages where the component renders)

# Wiki CE
tt_content.wiki =< lib.contentElement
tt_content.wiki {
    templateName = Wiki
    dataProcessing {
        10 = Connetation\Elements\DataProcessing\WikiPagesProcessor
        10 {
            as = wikiPages
        }
    }
}
