# ─────────────────────────────────────────────
# Video Hero Content Element – conn_t3wtk_elements
# ─────────────────────────────────────────────

tt_content.conn_video_hero =< lib.conn_t3wtk_elements_ce
tt_content.conn_video_hero {
    templateName = VideoHero
    dataProcessing {
        10 = Connetation\T3wtkElements\DataProcessing\FlexFormSettingsProcessor
        10 {
            fieldName = tx_conn_t3wtk_elements_video_hero_settings
        }
        # settings.height per device (vh) → height / heightTablet / heightMobile
        20 = Connetation\T3wtkElements\DataProcessing\ResponsiveSettingsProcessor
        20 {
            field = height
            min = 20
            max = 100
            default = 70
            legacy = medium:55,large:70,fullscreen:100
        }
    }
}
