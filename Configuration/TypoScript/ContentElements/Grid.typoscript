# ─────────────────────────────────────────────
# Bootstrap Grid Container Content Elements
# Powered by b13/container
# ─────────────────────────────────────────────

lib.contentElement.templateRootPaths.20 = EXT:conn_elements/Resources/Private/Templates/ContentElements/
lib.contentElement.partialRootPaths.20  = EXT:conn_elements/Resources/Private/Partials/

# ── 2 equal columns (col-md-6 / col-md-6) ────
tt_content.conn_grid_2col =< lib.contentElement
tt_content.conn_grid_2col {
    templateName = Grid2Col
    layoutRootPaths.20 = EXT:conn_elements/Resources/Private/Layouts/
    variables {
        column1 = CONTENT
        column1 {
            table = tt_content
            select {
                orderBy = sorting
                where = tx_container_parent={field:uid} AND colPos=200
                where.insertData = 1
            }
        }
        column2 = CONTENT
        column2 {
            table = tt_content
            select {
                orderBy = sorting
                where = tx_container_parent={field:uid} AND colPos=201
                where.insertData = 1
            }
        }
    }
}

