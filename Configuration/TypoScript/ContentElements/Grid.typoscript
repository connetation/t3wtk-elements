# ─────────────────────────────────────────────
# Bootstrap Grid Container Content Elements
# Powered by b13/container
# ─────────────────────────────────────────────

# ── 2 equal columns (col-md-6 / col-md-6) ────
tt_content.conn_grid_2col =< lib.conn_t3wtk_elements_ce
tt_content.conn_grid_2col {
    templateName = Grid2Col
    variables {
        column1 = CONTENT
        column1 {
            table = tt_content
            select {
                orderBy = sorting
                where = tx_container_parent={field:uid} AND colPos=200
                where.insertData = 1
            }
        }
        column2 = CONTENT
        column2 {
            table = tt_content
            select {
                orderBy = sorting
                where = tx_container_parent={field:uid} AND colPos=201
                where.insertData = 1
            }
        }
    }
}

