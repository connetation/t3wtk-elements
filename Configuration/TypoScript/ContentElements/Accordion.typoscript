# ─────────────────────────────────────────────
# Bootstrap Accordion Content Element – conn_elements
# ─────────────────────────────────────────────

tt_content.conn_bs_accordion =< lib.conn_elements_ce
tt_content.conn_bs_accordion {
    templateName = Accordion
    dataProcessing {
        10 = Connetation\Elements\DataProcessing\AccordionItemsProcessor
        10 {
            fieldName = tx_conn_elements_accordion_items
            as = items
        }
    }
}
