tt_content.conn_swiper_slider =< lib.contentElement
tt_content.conn_swiper_slider {
    templateName = Slider
    layoutRootPaths.20 = EXT:conn_elements/Resources/Private/Layouts/
    templateRootPaths.20 = EXT:conn_elements/Resources/Private/Templates/ContentElements/
    partialRootPaths.20 = EXT:conn_elements/Resources/Private/Partials/
    dataProcessing {
        10 = Connetation\Elements\DataProcessing\SlideItemsProcessor
        10 {
            fieldName = tx_conn_elements_slider_items
            settingsField = tx_conn_elements_slider_settings
            as = slides
        }
    }
}
