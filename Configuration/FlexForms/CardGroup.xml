<?xml version="1.0" encoding="UTF-8"?>
<T3DataStructure>
    <sheets>
        <sDEF>
            <ROOT>
                <sheetTitle>Display</sheetTitle>
                <type>array</type>
                <el>
                    <settings.columns>
                        <label>Cards per row</label>
                        <config>
                            <type>input</type>
                            <renderType>connResponsiveRange</renderType>
                            <responsive>
                                <lower>1</lower>
                                <upper>4</upper>
                                <step>1</step>
                                <auto>1</auto>
                            </responsive>
                            <default>3</default>
                        </config>
                    </settings.columns>
                    <settings.cardAlign>
                        <label>LLL:EXT:conn_t3wtk_base/Resources/Private/Language/locallang_be.xlf:card_align</label>
                        <description>LLL:EXT:conn_t3wtk_base/Resources/Private/Language/locallang_be.xlf:card_align.description</description>
                        <config>
                            <type>select</type>
                            <renderType>selectSingle</renderType>
                            <items type="array"></items>
                            <itemsProcFunc>Connetation\T3wtkBase\Utility\CardAlignOptions->addItems</itemsProcFunc>
                            <default>start</default>
                        </config>
                    </settings.cardAlign>
                    <settings.accentBar>
                        <label>Accent bar on hover</label>
                        <config>
                            <type>check</type>
                            <renderType>checkboxToggle</renderType>
                            <default>1</default>
                        </config>
                    </settings.accentBar>
                    <settings.style>
                        <label>Card style</label>
                        <config>
                            <type>select</type>
                            <renderType>selectSingle</renderType>
                            <default>default</default>
                            <items>
                                <numIndex index="0"><label>Default (bordered)</label><value>default</value></numIndex>
                                <numIndex index="1"><label>Shadow</label><value>shadow</value></numIndex>
                                <numIndex index="2"><label>Flat (no border)</label><value>flat</value></numIndex>
                            </items>
                        </config>
                    </settings.style>
                    <settings.bodyPosition>
                        <label>Body text position</label>
                        <config>
                            <type>select</type>
                            <renderType>selectSingle</renderType>
                            <default>top</default>
                            <items>
                                <numIndex index="0"><label>Top (default)</label><value>top</value></numIndex>
                                <numIndex index="1"><label>Center</label><value>center</value></numIndex>
                                <numIndex index="2"><label>Bottom</label><value>bottom</value></numIndex>
                            </items>
                        </config>
                    </settings.bodyPosition>
                </el>
            </ROOT>
        </sDEF>
        <typography>FILE:EXT:conn_t3wtk_elements/Configuration/FlexForms/Shared/CardTypography.xml</typography>
    </sheets>
</T3DataStructure>
