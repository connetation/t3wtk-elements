<?xml version="1.0" encoding="UTF-8"?>
<T3DataStructure>
    <sheets>
        <sDEF>
            <ROOT>
                <sheetTitle>Display</sheetTitle>
                <type>array</type>
                <el>
                    <settings.columns>
                        <label>Visible items</label>
                        <config>
                            <type>input</type>
                            <renderType>connResponsiveRange</renderType>
                            <responsive>
                                <lower>1</lower>
                                <upper>4</upper>
                                <step>1</step>
                            </responsive>
                            <default>4</default>
                        </config>
                    </settings.columns>
                    <settings.textPosition>
                        <label>Text Position</label>
                        <config>
                            <type>select</type>
                            <renderType>selectSingle</renderType>
                            <default>bottom</default>
                            <items>
                                <numIndex index="0"><label>Bottom (default)</label><value>bottom</value></numIndex>
                                <numIndex index="1"><label>Center</label><value>center</value></numIndex>
                                <numIndex index="2"><label>Top</label><value>top</value></numIndex>
                            </items>
                        </config>
                    </settings.textPosition>
                    <settings.textAlign>
                        <label>Text Alignment</label>
                        <config>
                            <type>select</type>
                            <renderType>selectSingle</renderType>
                            <default>left</default>
                            <items>
                                <numIndex index="0"><label>Left (default)</label><value>left</value></numIndex>
                                <numIndex index="1"><label>Center</label><value>center</value></numIndex>
                                <numIndex index="2"><label>Right</label><value>right</value></numIndex>
                            </items>
                        </config>
                    </settings.textAlign>
                    <settings.navPosition>
                        <label>Navigation</label>
                        <config>
                            <type>select</type>
                            <renderType>selectSingle</renderType>
                            <default>bottom</default>
                            <items>
                                <numIndex index="0"><label>Bottom center (default)</label><value>bottom</value></numIndex>
                                <numIndex index="1"><label>Sides (left / right)</label><value>sides</value></numIndex>
                                <numIndex index="2"><label>None (drag / swipe only)</label><value>none</value></numIndex>
                            </items>
                        </config>
                    </settings.navPosition>
                    <settings.autoplay>
                        <label>Autoplay</label>
                        <config>
                            <type>check</type>
                            <renderType>checkboxToggle</renderType>
                            <default>0</default>
                        </config>
                    </settings.autoplay>
                    <settings.autoplay_delay>
                        <label>Autoplay delay</label>
                        <config>
                            <type>select</type>
                            <renderType>selectSingle</renderType>
                            <default>4000</default>
                            <items>
                                <numIndex index="0"><label>3 seconds</label><value>3000</value></numIndex>
                                <numIndex index="1"><label>4 seconds (default)</label><value>4000</value></numIndex>
                                <numIndex index="2"><label>5 seconds</label><value>5000</value></numIndex>
                                <numIndex index="3"><label>7 seconds</label><value>7000</value></numIndex>
                            </items>
                        </config>
                    </settings.autoplay_delay>
                </el>
            </ROOT>
        </sDEF>
        <typography>FILE:EXT:conn_t3wtk_elements/Configuration/FlexForms/Shared/CardTypographyNoText.xml</typography>
    </sheets>
</T3DataStructure>
