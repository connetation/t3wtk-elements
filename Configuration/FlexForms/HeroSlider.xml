<?xml version="1.0" encoding="UTF-8"?>
<T3DataStructure>
    <sheets>
        <sDEF>
            <ROOT>
                <sheetTitle>Display</sheetTitle>
                <type>array</type>
                <el>
                    <settings.height>
                        <label>Slider height</label>
                        <config>
                            <type>select</type>
                            <renderType>selectSingle</renderType>
                            <default>large</default>
                            <items>
                                <numIndex index="0"><label>Medium (55vh)</label><value>medium</value></numIndex>
                                <numIndex index="1"><label>Large (70vh, default)</label><value>large</value></numIndex>
                                <numIndex index="2"><label>Fullscreen (100vh)</label><value>fullscreen</value></numIndex>
                            </items>
                        </config>
                    </settings.height>
                    <settings.effect>
                        <label>Transition effect</label>
                        <config>
                            <type>select</type>
                            <renderType>selectSingle</renderType>
                            <default>fade</default>
                            <items>
                                <numIndex index="0"><label>Fade (default)</label><value>fade</value></numIndex>
                                <numIndex index="1"><label>Slide</label><value>slide</value></numIndex>
                            </items>
                        </config>
                    </settings.effect>
                    <settings.autoplay>
                        <label>Autoplay</label>
                        <config>
                            <type>check</type>
                            <renderType>checkboxToggle</renderType>
                            <default>1</default>
                        </config>
                    </settings.autoplay>
                    <settings.autoplay_delay>
                        <label>Autoplay delay</label>
                        <config>
                            <type>select</type>
                            <renderType>selectSingle</renderType>
                            <default>5000</default>
                            <items>
                                <numIndex index="0"><label>3 seconds</label><value>3000</value></numIndex>
                                <numIndex index="1"><label>4 seconds</label><value>4000</value></numIndex>
                                <numIndex index="2"><label>5 seconds (default)</label><value>5000</value></numIndex>
                                <numIndex index="3"><label>7 seconds</label><value>7000</value></numIndex>
                            </items>
                        </config>
                    </settings.autoplay_delay>
                    <settings.show_navigation>
                        <label>Show prev/next arrows</label>
                        <config>
                            <type>check</type>
                            <renderType>checkboxToggle</renderType>
                            <default>1</default>
                        </config>
                    </settings.show_navigation>
                    <settings.show_pagination>
                        <label>Show pagination dots</label>
                        <config>
                            <type>check</type>
                            <renderType>checkboxToggle</renderType>
                            <default>1</default>
                        </config>
                    </settings.show_pagination>
                </el>
            </ROOT>
        </sDEF>
    </sheets>
</T3DataStructure>
