<?xml version="1.0" encoding="UTF-8"?>
<T3DataStructure>
    <sheets>
        <sDEF>
            <ROOT>
                <sheetTitle>Display</sheetTitle>
                <type>array</type>
                <el>
                    <settings.columns>
                        <label>Stats per row</label>
                        <config>
                            <type>input</type>
                            <renderType>connResponsiveRange</renderType>
                            <responsive>
                                <lower>1</lower>
                                <upper>4</upper>
                                <step>1</step>
                                <auto>1</auto>
                            </responsive>
                            <default>4</default>
                        </config>
                    </settings.columns>
                    <settings.layout>
                        <label>Layout</label>
                        <onChange>reload</onChange>
                        <config>
                            <type>select</type>
                            <renderType>selectSingle</renderType>
                            <default>default</default>
                            <items>
                                <numIndex index="0"><label>Cards (default)</label><value>default</value></numIndex>
                                <numIndex index="1"><label>Row (borderless)</label><value>row</value></numIndex>
                            </items>
                        </config>
                    </settings.layout>
                    <settings.showDivider>
                        <label>Show dividers between stats</label>
                        <displayCond>FIELD:settings.layout:=:row</displayCond>
                        <onChange>reload</onChange>
                        <config>
                            <type>check</type>
                            <renderType>checkboxToggle</renderType>
                            <default>1</default>
                        </config>
                    </settings.showDivider>
                    <settings.accentBar>
                        <label>Accent bar on hover</label>
                        <config>
                            <type>check</type>
                            <renderType>checkboxToggle</renderType>
                            <default>1</default>
                        </config>
                    </settings.accentBar>
                    <settings.countup>
                        <label>Animate numbers (count-up on scroll)</label>
                        <config>
                            <type>check</type>
                            <renderType>checkboxToggle</renderType>
                            <items>
                                <numIndex index="0"><label></label></numIndex>
                            </items>
                            <default>1</default>
                        </config>
                    </settings.countup>
                    <settings.duration>
                        <label>Count-up duration (seconds)</label>
                        <config>
                            <type>input</type>
                            <size>5</size>
                            <default>2</default>
                            <placeholder>2</placeholder>
                        </config>
                    </settings.duration>
                </el>
            </ROOT>
        </sDEF>
        <colors>
            <ROOT>
                <sheetTitle>Colors &amp; Shadows</sheetTitle>
                <type>array</type>
                <el>
                    <settings.valueColor>
                        <label>Number color — value, prefix and suffix (empty = theme accent)</label>
                        <config>
                            <type>color</type>
                            <opacity>1</opacity>
                        </config>
                    </settings.valueColor>
                    <settings.valueShadowColor>
                        <label>Number text shadow color — value, prefix and suffix (empty = no shadow)</label>
                        <config>
                            <type>color</type>
                            <opacity>1</opacity>
                        </config>
                    </settings.valueShadowColor>
                    <settings.labelColor>
                        <label>Label color (empty = theme heading color)</label>
                        <config>
                            <type>color</type>
                            <opacity>1</opacity>
                        </config>
                    </settings.labelColor>
                    <settings.labelShadowColor>
                        <label>Label text shadow color (empty = no shadow)</label>
                        <config>
                            <type>color</type>
                            <opacity>1</opacity>
                        </config>
                    </settings.labelShadowColor>
                    <settings.descriptionColor>
                        <label>Description color (empty = theme text color)</label>
                        <config>
                            <type>color</type>
                            <opacity>1</opacity>
                        </config>
                    </settings.descriptionColor>
                    <settings.descriptionShadowColor>
                        <label>Description text shadow color (empty = no shadow)</label>
                        <config>
                            <type>color</type>
                            <opacity>1</opacity>
                        </config>
                    </settings.descriptionShadowColor>
                    <settings.dividerColor>
                        <label>Divider color — lines between stats in the Row layout (empty = theme border color)</label>
                        <displayCond>
                            <AND>
                                <numIndex index="0">FIELD:sDEF.settings.layout:=:row</numIndex>
                                <numIndex index="1">FIELD:sDEF.settings.showDivider:!=:0</numIndex>
                            </AND>
                        </displayCond>
                        <config>
                            <type>color</type>
                            <opacity>1</opacity>
                        </config>
                    </settings.dividerColor>
                </el>
            </ROOT>
        </colors>
    </sheets>
</T3DataStructure>
