<?xml version="1.0" encoding="UTF-8"?>
<T3DataStructure>
    <sheets>
        <sDEF>
            <ROOT>
                <sheetTitle>Display</sheetTitle>
                <type>array</type>
                <el>
                    <settings.columns>
                        <label>Stats per row</label>
                        <config>
                            <type>select</type>
                            <renderType>selectSingle</renderType>
                            <default>4</default>
                            <items>
                                <numIndex index="0"><label>2 columns</label><value>2</value></numIndex>
                                <numIndex index="1"><label>3 columns</label><value>3</value></numIndex>
                                <numIndex index="2"><label>4 columns (default)</label><value>4</value></numIndex>
                            </items>
                        </config>
                    </settings.columns>
                    <settings.layout>
                        <label>Layout</label>
                        <config>
                            <type>select</type>
                            <renderType>selectSingle</renderType>
                            <default>default</default>
                            <items>
                                <numIndex index="0"><label>Cards (default)</label><value>default</value></numIndex>
                                <numIndex index="1"><label>Row (borderless)</label><value>row</value></numIndex>
                            </items>
                        </config>
                    </settings.layout>
                    <settings.accentBar>
                        <label>Accent bar on hover</label>
                        <config>
                            <type>check</type>
                            <renderType>checkboxToggle</renderType>
                            <default>1</default>
                        </config>
                    </settings.accentBar>
                    <settings.countup>
                        <label>Animate numbers (count-up on scroll)</label>
                        <config>
                            <type>check</type>
                            <renderType>checkboxToggle</renderType>
                            <items>
                                <numIndex index="0"><label></label></numIndex>
                            </items>
                            <default>1</default>
                        </config>
                    </settings.countup>
                    <settings.duration>
                        <label>Count-up duration (seconds)</label>
                        <config>
                            <type>input</type>
                            <size>5</size>
                            <default>2</default>
                            <placeholder>2</placeholder>
                        </config>
                    </settings.duration>
                </el>
            </ROOT>
        </sDEF>
    </sheets>
</T3DataStructure>
