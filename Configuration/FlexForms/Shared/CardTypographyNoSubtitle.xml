<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<!--
    Shared "Typography" sheet for card elements, referenced from each card
    FlexForm as <sheets><typography>FILE:EXT:…/Shared/CardTypographyNoSubtitle.xml</typography>.
    Options come from Connetation\T3wtkBase\Utility\FontWeightOptions; the
    processors validate with FontWeightOptions::resolveCard().
-->
<T3DataStructure>
    <ROOT>
        <sheetTitle>LLL:EXT:conn_t3wtk_base/Resources/Private/Language/locallang_be.xlf:flexform.sheet.typography</sheetTitle>
        <type>array</type>
        <el>
            <settings.titleWeight>
                <label>LLL:EXT:conn_t3wtk_base/Resources/Private/Language/locallang_be.xlf:flexform.titleWeight</label>
                <config>
                    <type>select</type>
                    <renderType>selectSingle</renderType>
                    <items type="array"></items>
                    <itemsProcFunc>Connetation\T3wtkBase\Utility\FontWeightOptions->addItems</itemsProcFunc>
                    <default>fw-normal</default>
                </config>
            </settings.titleWeight>
            <settings.textWeight>
                <label>LLL:EXT:conn_t3wtk_base/Resources/Private/Language/locallang_be.xlf:flexform.textWeight</label>
                <config>
                    <type>select</type>
                    <renderType>selectSingle</renderType>
                    <items type="array"></items>
                    <itemsProcFunc>Connetation\T3wtkBase\Utility\FontWeightOptions->addItems</itemsProcFunc>
                    <default>fw-normal</default>
                </config>
            </settings.textWeight>
        </el>
    </ROOT>
</T3DataStructure>
