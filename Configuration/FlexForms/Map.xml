<?xml version="1.0" encoding="UTF-8"?>
<T3DataStructure>
    <sheets>
        <sDEF>
            <ROOT>
                <sheetTitle>Display</sheetTitle>
                <type>array</type>
                <el>
                    <settings.provider>
                        <label>Map provider</label>
                        <description>"Illustrative" shows your own uploaded image (below), or a decorative placeholder if none is set — no third-party embed at all. "Google Maps" loads a real, keyless Google Maps embed for this element's address (Location tab) — falling back to Site Settings → Contact Information if nothing is overridden there.</description>
                        <onChange>reload</onChange>
                        <config>
                            <type>select</type>
                            <renderType>selectSingle</renderType>
                            <default>static</default>
                            <items>
                                <numIndex index="0"><label>Illustrative (image or placeholder)</label><value>static</value></numIndex>
                                <numIndex index="1"><label>Google Maps</label><value>google</value></numIndex>
                            </items>
                        </config>
                    </settings.provider>
                    <settings.privacyMode>
                        <label>Click to load</label>
                        <description>On: shows the illustrative placeholder with a "Load map" button — nothing is requested from Google until the visitor clicks. Off: the real map loads immediately with the page.</description>
                        <config>
                            <type>check</type>
                            <renderType>checkboxToggle</renderType>
                            <default>1</default>
                            <displayCond>FIELD:sDEF.settings.provider:=:google</displayCond>
                        </config>
                    </settings.privacyMode>
                    <settings.zoom>
                        <label>Zoom level</label>
                        <description>1 (whole world) to 20 (building-level). 14–16 suits a street address.</description>
                        <config>
                            <type>number</type>
                            <default>15</default>
                            <range>
                                <lower>1</lower>
                                <upper>20</upper>
                            </range>
                            <displayCond>FIELD:sDEF.settings.provider:=:google</displayCond>
                        </config>
                    </settings.zoom>
                    <settings.height>
                        <label>Map height</label>
                        <config>
                            <type>select</type>
                            <renderType>selectSingle</renderType>
                            <default>md</default>
                            <items>
                                <numIndex index="0"><label>Small (300px)</label><value>sm</value></numIndex>
                                <numIndex index="1"><label>Medium (400px)</label><value>md</value></numIndex>
                                <numIndex index="2"><label>Large (550px)</label><value>lg</value></numIndex>
                            </items>
                        </config>
                    </settings.height>
                    <settings.showGridOverImage>
                        <label>Show grid over image</label>
                        <description>Only relevant once an illustration image is set (Media tab). Off (default): the image replaces the decorative grid entirely. On: keeps the grid pattern visible on top of your image.</description>
                        <config>
                            <type>check</type>
                            <renderType>checkboxToggle</renderType>
                            <default>0</default>
                            <displayCond>FIELD:sDEF.settings.provider:=:static</displayCond>
                        </config>
                    </settings.showGridOverImage>
                    <settings.gridColor>
                        <label>Grid color</label>
                        <description>Empty = theme default border color. Only relevant while the decorative grid is visible (Illustrative mode, no image or "Show grid over image" enabled).</description>
                        <config>
                            <type>color</type>
                            <opacity>1</opacity>
                            <displayCond>FIELD:sDEF.settings.provider:=:static</displayCond>
                        </config>
                    </settings.gridColor>
                    <settings.gap>
                        <label>Space between map and info panel</label>
                        <config>
                            <type>select</type>
                            <renderType>selectSingle</renderType>
                            <default>md</default>
                            <items>
                                <numIndex index="0"><label>None</label><value>none</value></numIndex>
                                <numIndex index="1"><label>Small</label><value>sm</value></numIndex>
                                <numIndex index="2"><label>Medium (default)</label><value>md</value></numIndex>
                                <numIndex index="3"><label>Large</label><value>lg</value></numIndex>
                            </items>
                        </config>
                    </settings.gap>
                    <settings.borderRadius>
                        <label>Border radius</label>
                        <description>Applies to both the map canvas and the info panel.</description>
                        <config>
                            <type>select</type>
                            <renderType>selectSingle</renderType>
                            <default>medium</default>
                            <items>
                                <numIndex index="0"><label>None</label><value>none</value></numIndex>
                                <numIndex index="1"><label>Small (4 px)</label><value>small</value></numIndex>
                                <numIndex index="2"><label>Medium (default)</label><value>medium</value></numIndex>
                                <numIndex index="3"><label>Large (24 px)</label><value>large</value></numIndex>
                                <numIndex index="4"><label>Pill (fully rounded)</label><value>pill</value></numIndex>
                            </items>
                        </config>
                    </settings.borderRadius>
                </el>
            </ROOT>
        </sDEF>
        <location>
            <ROOT>
                <sheetTitle>Location</sheetTitle>
                <type>array</type>
                <el>
                    <settings.contact.address.company>
                        <label>Company name</label>
                        <description>Leave empty to use the site-wide company name (Site Settings → Contact Information). Only fill this in when this element shows a different office than the default.</description>
                        <config>
                            <type>input</type>
                            <size>30</size>
                            <eval>trim</eval>
                        </config>
                    </settings.contact.address.company>
                    <settings.contact.address.street>
                        <label>Street address</label>
                        <description>Leave empty to use the site-wide street address.</description>
                        <config>
                            <type>input</type>
                            <size>30</size>
                            <eval>trim</eval>
                        </config>
                    </settings.contact.address.street>
                    <settings.contact.address.zip>
                        <label>ZIP / Postal code</label>
                        <description>Leave empty to use the site-wide ZIP code.</description>
                        <config>
                            <type>input</type>
                            <size>10</size>
                            <eval>trim</eval>
                        </config>
                    </settings.contact.address.zip>
                    <settings.contact.address.city>
                        <label>City</label>
                        <description>Leave empty to use the site-wide city.</description>
                        <config>
                            <type>input</type>
                            <size>20</size>
                            <eval>trim</eval>
                        </config>
                    </settings.contact.address.city>
                    <settings.contact.address.country>
                        <label>Country</label>
                        <description>Leave empty to use the site-wide country.</description>
                        <config>
                            <type>input</type>
                            <size>20</size>
                            <eval>trim</eval>
                        </config>
                    </settings.contact.address.country>
                    <settings.contact.address.url>
                        <label>Directions link (e.g. Google Maps)</label>
                        <description>Used for the "Get directions" button. Leave empty to use the site-wide link — but if you overrode the address above for a different office, set this too, or directions will point to the wrong place.</description>
                        <config>
                            <type>link</type>
                            <size>50</size>
                        </config>
                    </settings.contact.address.url>
                    <settings.contact.phone>
                        <label>Phone number</label>
                        <description>Leave empty to use the site-wide phone number.</description>
                        <config>
                            <type>input</type>
                            <size>20</size>
                            <eval>trim</eval>
                        </config>
                    </settings.contact.phone>
                    <settings.contact.email>
                        <label>E-mail address</label>
                        <description>Leave empty to use the site-wide e-mail address.</description>
                        <config>
                            <type>input</type>
                            <size>30</size>
                            <eval>trim</eval>
                        </config>
                    </settings.contact.email>
                    <settings.contact.officeHours>
                        <label>Office hours</label>
                        <description>Leave empty to use the site-wide office hours.</description>
                        <config>
                            <type>input</type>
                            <size>40</size>
                            <eval>trim</eval>
                        </config>
                    </settings.contact.officeHours>
                </el>
            </ROOT>
        </location>
        <panel>
            <ROOT>
                <sheetTitle>Info Panel</sheetTitle>
                <type>array</type>
                <el>
                    <settings.showInfoPanel>
                        <label>Show contact info panel</label>
                        <config>
                            <type>check</type>
                            <renderType>checkboxToggle</renderType>
                            <default>1</default>
                        </config>
                    </settings.showInfoPanel>
                    <settings.panelPosition>
                        <label>Info panel position</label>
                        <config>
                            <type>select</type>
                            <renderType>selectSingle</renderType>
                            <default>right</default>
                            <items>
                                <numIndex index="0"><label>Right</label><value>right</value></numIndex>
                                <numIndex index="1"><label>Left</label><value>left</value></numIndex>
                            </items>
                            <displayCond>FIELD:sDEF.settings.showInfoPanel:=:1</displayCond>
                        </config>
                    </settings.panelPosition>
                    <settings.showDirectionsButton>
                        <label>Show "Get directions" button</label>
                        <description>Only shown when a directions URL is set (Location tab, or Site Settings → Contact Information as a fallback).</description>
                        <config>
                            <type>check</type>
                            <renderType>checkboxToggle</renderType>
                            <default>1</default>
                            <displayCond>FIELD:sDEF.settings.showInfoPanel:=:1</displayCond>
                        </config>
                    </settings.showDirectionsButton>
                </el>
            </ROOT>
        </panel>
    </sheets>
</T3DataStructure>
