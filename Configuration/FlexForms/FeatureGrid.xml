<?xml version="1.0" encoding="UTF-8"?>
<T3DataStructure>
    <sheets>
        <sDEF>
            <ROOT>
                <sheetTitle>Display</sheetTitle>
                <type>array</type>
                <el>
                    <settings.columns>
                        <label>Features per row</label>
                        <config>
                            <type>select</type>
                            <renderType>selectSingle</renderType>
                            <default>3</default>
                            <items>
                                <numIndex index="0"><label>2 columns</label><value>2</value></numIndex>
                                <numIndex index="1"><label>3 columns (default)</label><value>3</value></numIndex>
                                <numIndex index="2"><label>4 columns</label><value>4</value></numIndex>
                            </items>
                        </config>
                    </settings.columns>
                    <settings.variant>
                        <label>Variant</label>
                        <config>
                            <type>select</type>
                            <renderType>selectSingle</renderType>
                            <default>default</default>
                            <items>
                                <numIndex index="0"><label>Default</label><value>default</value></numIndex>
                                <numIndex index="1"><label>Steps (auto-numbered)</label><value>steps</value></numIndex>
                                <numIndex index="2"><label>Horizontal (icon left)</label><value>horizontal</value></numIndex>
                            </items>
                        </config>
                    </settings.variant>
                    <settings.accentBar>
                        <label>Accent bar on hover</label>
                        <config>
                            <type>check</type>
                            <renderType>checkboxToggle</renderType>
                            <default>1</default>
                        </config>
                    </settings.accentBar>
                    <settings.iconStyle>
                        <label>Icon background style</label>
                        <config>
                            <type>select</type>
                            <renderType>selectSingle</renderType>
                            <default>soft</default>
                            <items>
                                <numIndex index="0"><label>Soft (accent tinted)</label><value>soft</value></numIndex>
                                <numIndex index="1"><label>Solid accent</label><value>solid</value></numIndex>
                                <numIndex index="2"><label>None</label><value>none</value></numIndex>
                            </items>
                        </config>
                    </settings.iconStyle>
                </el>
            </ROOT>
        </sDEF>
    </sheets>
</T3DataStructure>
