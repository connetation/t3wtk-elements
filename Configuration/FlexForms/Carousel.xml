<?xml version="1.0" encoding="UTF-8"?>
<T3DataStructure>
    <sheets>
        <sDEF>
            <ROOT>
                <sheetTitle>Display</sheetTitle>
                <type>array</type>
                <el>
                    <settings.aspectRatio>
                        <label>Aspect ratio</label>
                        <onChange>reload</onChange>
                        <config>
                            <type>select</type>
                            <renderType>selectSingle</renderType>
                            <default>16x9</default>
                            <items>
                                <numIndex index="0"><label>21:9 – Cinematic</label><value>21x9</value></numIndex>
                                <numIndex index="1"><label>16:9 – Widescreen (default)</label><value>16x9</value></numIndex>
                                <numIndex index="2"><label>4:3 – Standard</label><value>4x3</value></numIndex>
                                <numIndex index="3"><label>1:1 – Square</label><value>1x1</value></numIndex>
                                <numIndex index="4"><label>Original (no cropping)</label><value>original</value></numIndex>
                            </items>
                        </config>
                    </settings.aspectRatio>
                    <settings.originalHeight>
                        <label>Original ratio — height</label>
                        <description>With "Original" aspect ratio, images of different proportions otherwise change the carousel's height per slide. Auto keeps that natural per-slide height; a fixed height instead letterboxes each image (no cropping) inside a consistent box.</description>
                        <displayCond>FIELD:settings.aspectRatio:=:original</displayCond>
                        <config>
                            <type>select</type>
                            <renderType>selectSingle</renderType>
                            <default>auto</default>
                            <items>
                                <numIndex index="0"><label>Auto (natural height, may jump between slides)</label><value>auto</value></numIndex>
                                <numIndex index="1"><label>Medium (55vh)</label><value>55vh</value></numIndex>
                                <numIndex index="2"><label>Large (70vh)</label><value>70vh</value></numIndex>
                                <numIndex index="3"><label>Full screen (100vh)</label><value>100vh</value></numIndex>
                            </items>
                        </config>
                    </settings.originalHeight>
                    <settings.controls>
                        <label>Show controls (prev / next buttons)</label>
                        <config>
                            <type>check</type>
                            <renderType>checkboxToggle</renderType>
                            <default>1</default>
                        </config>
                    </settings.controls>
                    <settings.indicators>
                        <label>Show indicators (slide dots)</label>
                        <config>
                            <type>check</type>
                            <renderType>checkboxToggle</renderType>
                            <default>1</default>
                        </config>
                    </settings.indicators>
                    <settings.autoplay>
                        <label>Autoplay</label>
                        <config>
                            <type>check</type>
                            <renderType>checkboxToggle</renderType>
                            <default>0</default>
                        </config>
                    </settings.autoplay>
                    <settings.interval>
                        <label>Autoplay interval (ms)</label>
                        <config>
                            <type>number</type>
                            <default>5000</default>
                            <range>
                                <lower>1000</lower>
                                <upper>30000</upper>
                            </range>
                        </config>
                    </settings.interval>
                    <settings.fade>
                        <label>Crossfade transition (instead of slide)</label>
                        <config>
                            <type>check</type>
                            <renderType>checkboxToggle</renderType>
                            <default>0</default>
                        </config>
                    </settings.fade>
                    <settings.dark>
                        <label>Dark variant (dark controls &amp; indicators)</label>
                        <config>
                            <type>check</type>
                            <renderType>checkboxToggle</renderType>
                            <default>0</default>
                        </config>
                    </settings.dark>
                    <settings.style>
                        <label>Style</label>
                        <config>
                            <type>select</type>
                            <renderType>selectSingle</renderType>
                            <default>none</default>
                            <items>
                                <numIndex index="0"><label>None (default)</label><value>none</value></numIndex>
                                <numIndex index="1"><label>Shadow</label><value>shadow</value></numIndex>
                                <numIndex index="2"><label>Border</label><value>border</value></numIndex>
                            </items>
                        </config>
                    </settings.style>
                    <settings.borderRadius>
                        <label>Border radius</label>
                        <config>
                            <type>select</type>
                            <renderType>selectSingle</renderType>
                            <default>none</default>
                            <items>
                                <numIndex index="0"><label>None (default)</label><value>none</value></numIndex>
                                <numIndex index="1"><label>Small (4 px)</label><value>small</value></numIndex>
                                <numIndex index="2"><label>Theme default (site "Corner radius" setting)</label><value>medium</value></numIndex>
                                <numIndex index="3"><label>Large (24 px)</label><value>large</value></numIndex>
                            </items>
                        </config>
                    </settings.borderRadius>
                    <settings.openInLightbox>
                        <label>Open in lightbox</label>
                        <config>
                            <type>check</type>
                            <renderType>checkboxToggle</renderType>
                            <default>0</default>
                        </config>
                    </settings.openInLightbox>
                    <settings.captionTitleColor>
                        <label>Caption title color</label>
                        <config>
                            <type>color</type>
                            <default>#ffffff</default>
                            <opacity>true</opacity>
                        </config>
                    </settings.captionTitleColor>
                    <settings.captionTextColor>
                        <label>Caption text color</label>
                        <config>
                            <type>color</type>
                            <default>#ffffff</default>
                            <opacity>true</opacity>
                        </config>
                    </settings.captionTextColor>
                    <settings.captionBgColor>
                        <label>Caption background color</label>
                        <config>
                            <type>color</type>
                            <default>#00000094</default>
                            <opacity>true</opacity>
                        </config>
                    </settings.captionBgColor>
                </el>
            </ROOT>
        </sDEF>
    </sheets>
</T3DataStructure>
