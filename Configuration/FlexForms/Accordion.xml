<?xml version="1.0" encoding="UTF-8"?>
<T3DataStructure>
    <sheets>
        <sDEF>
            <ROOT>
                <sheetTitle>Display</sheetTitle>
                <type>array</type>
                <el>
                    <settings.style>
                        <label>Style</label>
                        <config>
                            <type>select</type>
                            <renderType>selectSingle</renderType>
                            <default>default</default>
                            <items>
                                <numIndex index="0"><label>Default</label><value>default</value></numIndex>
                                <numIndex index="1"><label>Flush (no borders / rounded corners)</label><value>flush</value></numIndex>
                            </items>
                        </config>
                    </settings.style>
                    <settings.alwaysOpen>
                        <label>Always open (allow multiple items expanded simultaneously)</label>
                        <config>
                            <type>check</type>
                            <renderType>checkboxToggle</renderType>
                            <default>0</default>
                        </config>
                    </settings.alwaysOpen>
                    <settings.collapseAll>
                        <label>Start with all items collapsed</label>
                        <config>
                            <type>check</type>
                            <renderType>checkboxToggle</renderType>
                            <default>0</default>
                        </config>
                    </settings.collapseAll>
                    <settings.useAsFaq>
                        <label>Use as FAQ</label>
                        <description>Also generates FAQPage structured data (schema.org JSON-LD) — Google can show your questions directly in search results. Enable this only for actual FAQ content; leave off for any other collapsible content.</description>
                        <config>
                            <type>check</type>
                            <renderType>checkboxToggle</renderType>
                            <default>0</default>
                        </config>
                    </settings.useAsFaq>
                </el>
            </ROOT>
        </sDEF>
    </sheets>
</T3DataStructure>
