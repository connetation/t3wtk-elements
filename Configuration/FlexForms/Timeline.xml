<?xml version="1.0" encoding="UTF-8"?>
<T3DataStructure>
    <sheets>
        <sDEF>
            <ROOT>
                <sheetTitle>Display</sheetTitle>
                <type>array</type>
                <el>
                    <settings.layout>
                        <label>Timeline Layout</label>
                        <config>
                            <type>select</type>
                            <renderType>selectSingle</renderType>
                            <default>changelog</default>
                            <items>
                                <numIndex index="0"><label>Product Changelog</label><value>changelog</value></numIndex>
                                <numIndex index="1"><label>Company Timeline</label><value>responsive</value></numIndex>
                                <numIndex index="2"><label>Timeline Scroll</label><value>scroll</value></numIndex>
                            </items>
                        </config>
                    </settings.layout>
                    <settings.position>
                        <label>Line Position</label>
                        <displayCond>FIELD:settings.layout:=:changelog</displayCond>
                        <config>
                            <type>select</type>
                            <renderType>selectSingle</renderType>
                            <default>left</default>
                            <items>
                                <numIndex index="0"><label>Left</label><value>left</value></numIndex>
                                <numIndex index="1"><label>Center</label><value>center</value></numIndex>
                                <numIndex index="2"><label>Right</label><value>right</value></numIndex>
                            </items>
                        </config>
                    </settings.position>
                    <settings.track_align>
                        <label>Track Alignment</label>
                        <displayCond>FIELD:settings.layout:=:changelog</displayCond>
                        <config>
                            <type>select</type>
                            <renderType>selectSingle</renderType>
                            <default>center</default>
                            <items>
                                <numIndex index="0"><label>Left</label><value>left</value></numIndex>
                                <numIndex index="1"><label>Center</label><value>center</value></numIndex>
                                <numIndex index="2"><label>Right</label><value>right</value></numIndex>
                            </items>
                        </config>
                    </settings.track_align>
                    <settings.line_style>
                        <label>Line Style</label>
                        <config>
                            <type>select</type>
                            <renderType>selectSingle</renderType>
                            <default>solid</default>
                            <items>
                                <numIndex index="0"><label>Solid</label><value>solid</value></numIndex>
                                <numIndex index="1"><label>Dashed</label><value>dashed</value></numIndex>
                                <numIndex index="2"><label>Dotted</label><value>dotted</value></numIndex>
                            </items>
                        </config>
                    </settings.line_style>
                    <settings.show_item_date>
                        <label>Show full date inside card</label>
                        <displayCond>FIELD:settings.layout:=:scroll</displayCond>
                        <config>
                            <type>check</type>
                            <renderType>checkboxToggle</renderType>
                            <default>0</default>
                        </config>
                    </settings.show_item_date>
                    <settings.sort_order>
                        <label>Sort Order</label>
                        <config>
                            <type>select</type>
                            <renderType>selectSingle</renderType>
                            <default>custom</default>
                            <items>
                                <numIndex index="0"><label>Custom (manual order)</label><value>custom</value></numIndex>
                                <numIndex index="1"><label>Date ascending</label><value>date_asc</value></numIndex>
                                <numIndex index="2"><label>Date descending</label><value>date_desc</value></numIndex>
                            </items>
                        </config>
                    </settings.sort_order>
                </el>
            </ROOT>
        </sDEF>
    </sheets>
</T3DataStructure>
