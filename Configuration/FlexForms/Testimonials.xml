<?xml version="1.0" encoding="UTF-8"?>
<T3DataStructure>
    <sheets>
        <sDEF>
            <ROOT>
                <sheetTitle>Display</sheetTitle>
                <type>array</type>
                <el>
                    <settings.layout>
                        <label>Layout</label>
                        <config>
                            <type>select</type>
                            <renderType>selectSingle</renderType>
                            <default>grid</default>
                            <items>
                                <numIndex index="0"><label>Grid</label><value>grid</value></numIndex>
                                <numIndex index="1"><label>Carousel (Swiper)</label><value>carousel</value></numIndex>
                            </items>
                        </config>
                    </settings.layout>
                    <settings.columns>
                        <label>Testimonials per row (grid) / visible at once (carousel)</label>
                        <config>
                            <type>input</type>
                            <renderType>connResponsiveRange</renderType>
                            <responsive>
                                <lower>1</lower>
                                <upper>4</upper>
                                <step>1</step>
                                <auto>1</auto>
                            </responsive>
                            <default>3</default>
                        </config>
                    </settings.columns>
                    <settings.autoplay>
                        <label>Autoplay (Carousel only)</label>
                        <config>
                            <type>check</type>
                            <renderType>checkboxToggle</renderType>
                            <items>
                                <numIndex index="0"><label></label></numIndex>
                            </items>
                            <default>1</default>
                        </config>
                    </settings.autoplay>
                    <settings.autoplayDelay>
                        <label>Autoplay delay (ms)</label>
                        <config>
                            <type>input</type>
                            <size>8</size>
                            <default>4000</default>
                            <placeholder>4000</placeholder>
                        </config>
                    </settings.autoplayDelay>
                    <settings.accentBar>
                        <label>Accent bar on hover</label>
                        <config>
                            <type>check</type>
                            <renderType>checkboxToggle</renderType>
                            <default>1</default>
                        </config>
                    </settings.accentBar>
                    <settings.showRating>
                        <label>Show star rating</label>
                        <config>
                            <type>check</type>
                            <renderType>checkboxToggle</renderType>
                            <items>
                                <numIndex index="0"><label></label></numIndex>
                            </items>
                            <default>1</default>
                        </config>
                    </settings.showRating>
                </el>
            </ROOT>
        </sDEF>
    </sheets>
</T3DataStructure>
