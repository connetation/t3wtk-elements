<?xml version="1.0" encoding="UTF-8"?>
<T3DataStructure>
    <sheets>
        <sDEF>
            <ROOT>
                <sheetTitle>Display</sheetTitle>
                <type>array</type>
                <el>
                    <settings.columns>
                        <label>Columns per row</label>
                        <config>
                            <type>select</type>
                            <renderType>selectSingle</renderType>
                            <default>3</default>
                            <items>
                                <numIndex index="0"><label>2 columns</label><value>2</value></numIndex>
                                <numIndex index="1"><label>3 columns (default)</label><value>3</value></numIndex>
                                <numIndex index="2"><label>4 columns</label><value>4</value></numIndex>
                                <numIndex index="3"><label>6 columns (small thumbnails)</label><value>6</value></numIndex>
                            </items>
                        </config>
                    </settings.columns>
                    <settings.gap>
                        <label>Space between items</label>
                        <config>
                            <type>select</type>
                            <renderType>selectSingle</renderType>
                            <default>medium</default>
                            <items>
                                <numIndex index="0"><label>None</label><value>none</value></numIndex>
                                <numIndex index="1"><label>Small (8 px)</label><value>small</value></numIndex>
                                <numIndex index="2"><label>Medium (16 px, default)</label><value>medium</value></numIndex>
                                <numIndex index="3"><label>Large (24 px)</label><value>large</value></numIndex>
                            </items>
                        </config>
                    </settings.gap>
                    <settings.fit>
                        <label>Image fit</label>
                        <description>Fill container: each thumbnail covers its full square box, cropping the edges as needed (default). Keep aspect ratio: the whole image stays visible in the box, uncropped, with letterbox bars filling any leftover space. Either way, opening an image in the lightbox always shows it in full, uncropped.</description>
                        <config>
                            <type>select</type>
                            <renderType>selectSingle</renderType>
                            <default>cover</default>
                            <items>
                                <numIndex index="0"><label>Fill container (crop to fit)</label><value>cover</value></numIndex>
                                <numIndex index="1"><label>Keep aspect ratio (letterboxed)</label><value>contain</value></numIndex>
                            </items>
                        </config>
                    </settings.fit>
                    <settings.backgroundColor>
                        <label>Letterbox background color</label>
                        <description>Fills the empty space left when an image doesn't fully cover its box. Leave empty to use the theme's default surface color. Only used when Image fit above is set to Keep aspect ratio.</description>
                        <displayCond>FIELD:sDEF.settings.fit:=:contain</displayCond>
                        <config>
                            <type>color</type>
                            <opacity>1</opacity>
                        </config>
                    </settings.backgroundColor>
                    <settings.textPosition>
                        <label>Text Position</label>
                        <config>
                            <type>select</type>
                            <renderType>selectSingle</renderType>
                            <default>bottom</default>
                            <items>
                                <numIndex index="0"><label>Bottom (default)</label><value>bottom</value></numIndex>
                                <numIndex index="1"><label>Center</label><value>center</value></numIndex>
                                <numIndex index="2"><label>Top</label><value>top</value></numIndex>
                            </items>
                        </config>
                    </settings.textPosition>
                    <settings.textAlign>
                        <label>Text Alignment</label>
                        <config>
                            <type>select</type>
                            <renderType>selectSingle</renderType>
                            <default>left</default>
                            <items>
                                <numIndex index="0"><label>Left (default)</label><value>left</value></numIndex>
                                <numIndex index="1"><label>Center</label><value>center</value></numIndex>
                                <numIndex index="2"><label>Right</label><value>right</value></numIndex>
                            </items>
                        </config>
                    </settings.textAlign>
                    <settings.captionInLightboxOnly>
                        <label>Show caption only in lightbox</label>
                        <description>Keeps the title visible in the grid, but hides the caption text there — it only appears once an image is opened. Leave unchecked to show both in the grid, as before.</description>
                        <config>
                            <type>check</type>
                            <renderType>checkboxToggle</renderType>
                            <default>0</default>
                        </config>
                    </settings.captionInLightboxOnly>
                </el>
            </ROOT>
        </sDEF>
        <border>
            <ROOT>
                <sheetTitle>Border</sheetTitle>
                <type>array</type>
                <el>
                    <settings.borderStyle>
                        <label>Border style</label>
                        <config>
                            <type>select</type>
                            <renderType>selectSingle</renderType>
                            <default>dashed</default>
                            <items>
                                <numIndex index="0"><label>None</label><value>none</value></numIndex>
                                <numIndex index="1"><label>Solid</label><value>solid</value></numIndex>
                                <numIndex index="2"><label>Dashed (default)</label><value>dashed</value></numIndex>
                                <numIndex index="3"><label>Dotted</label><value>dotted</value></numIndex>
                            </items>
                        </config>
                    </settings.borderStyle>
                    <settings.borderColor>
                        <label>Border color</label>
                        <description>Leave empty to use the theme's default border color. Only used when Border style above isn't None.</description>
                        <displayCond>FIELD:border.settings.borderStyle:!=:none</displayCond>
                        <config>
                            <type>color</type>
                            <opacity>1</opacity>
                        </config>
                    </settings.borderColor>
                    <settings.borderRadius>
                        <label>Border radius</label>
                        <config>
                            <type>select</type>
                            <renderType>selectSingle</renderType>
                            <default>theme</default>
                            <itemsProcFunc>Connetation\T3wtkBase\Utility\RadiusOptions->addItems</itemsProcFunc>
                        </config>
                    </settings.borderRadius>
                </el>
            </ROOT>
        </border>
    </sheets>
</T3DataStructure>
