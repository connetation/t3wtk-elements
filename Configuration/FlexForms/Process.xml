<?xml version="1.0" encoding="UTF-8"?>
<T3DataStructure>
    <sheets>
        <sDEF>
            <ROOT>
                <sheetTitle>Display</sheetTitle>
                <type>array</type>
                <el>
                    <settings.numbered>
                        <label>Show step numbers</label>
                        <config>
                            <type>check</type>
                            <renderType>checkboxToggle</renderType>
                            <default>1</default>
                        </config>
                    </settings.numbered>
                    <settings.connectorStyle>
                        <label>Connector line</label>
                        <config>
                            <type>select</type>
                            <renderType>selectSingle</renderType>
                            <default>solid</default>
                            <items>
                                <numIndex index="0"><label>None (not connected)</label><value>none</value></numIndex>
                                <numIndex index="1"><label>Solid</label><value>solid</value></numIndex>
                                <numIndex index="2"><label>Dashed</label><value>dashed</value></numIndex>
                                <numIndex index="3"><label>Dotted</label><value>dotted</value></numIndex>
                            </items>
                        </config>
                    </settings.connectorStyle>
                    <settings.maxPerRow>
                        <label>Maximum items per row</label>
                        <description>Caps how many steps sit in a row even on very wide screens, so e.g. 7 steps don't all end up in a single line — narrower screens still show fewer per row regardless of this setting.</description>
                        <config>
                            <type>select</type>
                            <renderType>selectSingle</renderType>
                            <default>0</default>
                            <items>
                                <numIndex index="0"><label>No limit</label><value>0</value></numIndex>
                                <numIndex index="1"><label>2 per row</label><value>2</value></numIndex>
                                <numIndex index="2"><label>3 per row</label><value>3</value></numIndex>
                                <numIndex index="3"><label>4 per row</label><value>4</value></numIndex>
                                <numIndex index="4"><label>5 per row</label><value>5</value></numIndex>
                                <numIndex index="5"><label>6 per row</label><value>6</value></numIndex>
                            </items>
                        </config>
                    </settings.maxPerRow>
                </el>
            </ROOT>
        </sDEF>
        <colors>
            <ROOT>
                <sheetTitle>Colors</sheetTitle>
                <type>array</type>
                <el>
                    <settings.connectorColor>
                        <label>Connector line color (empty = theme accent)</label>
                        <config>
                            <type>color</type>
                            <opacity>1</opacity>
                        </config>
                    </settings.connectorColor>
                    <settings.markerColor>
                        <label>Marker color (empty = theme default)</label>
                        <config>
                            <type>color</type>
                            <opacity>1</opacity>
                        </config>
                    </settings.markerColor>
                    <settings.markerBorderColor>
                        <label>Marker border color (empty = theme default)</label>
                        <config>
                            <type>color</type>
                            <opacity>1</opacity>
                        </config>
                    </settings.markerBorderColor>
                    <settings.markerNumberColor>
                        <label>Marker number/icon color (empty = theme accent)</label>
                        <config>
                            <type>color</type>
                            <opacity>1</opacity>
                        </config>
                    </settings.markerNumberColor>
                </el>
            </ROOT>
        </colors>
    </sheets>
</T3DataStructure>
