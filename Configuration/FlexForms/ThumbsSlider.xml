<?xml version="1.0" encoding="UTF-8"?>
<T3DataStructure>
    <sheets>
        <sDEF>
            <ROOT>
                <sheetTitle>Display</sheetTitle>
                <type>array</type>
                <el>
                    <settings.height>
                        <label>Slider height (vh)</label>
                        <config>
                            <type>input</type>
                            <renderType>connResponsiveRange</renderType>
                            <responsive>
                                <lower>20</lower>
                                <upper>100</upper>
                                <step>5</step>
                                <unit>vh</unit>
                            </responsive>
                            <default>70</default>
                        </config>
                    </settings.height>
                    <settings.borderRadius>
                        <label>Border radius</label>
                        <description>Rounds the slider's outer corners (main image + thumbnail strip as one unit). "Theme default" follows the site's Corner radius setting.</description>
                        <config>
                            <type>select</type>
                            <renderType>selectSingle</renderType>
                            <default>theme</default>
                            <itemsProcFunc>Connetation\T3wtkBase\Utility\RadiusOptions->addItems</itemsProcFunc>
                        </config>
                    </settings.borderRadius>
                    <settings.thumbs_per_view>
                        <label>Thumbnails visible at once</label>
                        <config>
                            <type>input</type>
                            <renderType>connResponsiveRange</renderType>
                            <responsive>
                                <lower>2</lower>
                                <upper>8</upper>
                                <step>1</step>
                            </responsive>
                            <default>4</default>
                        </config>
                    </settings.thumbs_per_view>
                    <settings.show_navigation>
                        <label>Show prev/next arrows</label>
                        <onChange>reload</onChange>
                        <config>
                            <type>check</type>
                            <renderType>checkboxToggle</renderType>
                            <default>1</default>
                        </config>
                    </settings.show_navigation>
                    <settings.hide_navigation_mobile>
                        <label>Hide arrows on mobile</label>
                        <displayCond>FIELD:settings.show_navigation:=:1</displayCond>
                        <config>
                            <type>check</type>
                            <renderType>checkboxToggle</renderType>
                            <default>0</default>
                        </config>
                    </settings.hide_navigation_mobile>
                    <settings.autoplay>
                        <label>Autoplay</label>
                        <config>
                            <type>check</type>
                            <renderType>checkboxToggle</renderType>
                            <default>0</default>
                        </config>
                    </settings.autoplay>
                    <settings.autoplay_delay>
                        <label>Autoplay delay</label>
                        <config>
                            <type>select</type>
                            <renderType>selectSingle</renderType>
                            <default>4000</default>
                            <items>
                                <numIndex index="0"><label>3 seconds</label><value>3000</value></numIndex>
                                <numIndex index="1"><label>4 seconds (default)</label><value>4000</value></numIndex>
                                <numIndex index="2"><label>5 seconds</label><value>5000</value></numIndex>
                                <numIndex index="3"><label>7 seconds</label><value>7000</value></numIndex>
                            </items>
                        </config>
                    </settings.autoplay_delay>
                    <settings.openInLightbox>
                        <label>Open in lightbox</label>
                        <config>
                            <type>check</type>
                            <renderType>checkboxToggle</renderType>
                            <default>0</default>
                        </config>
                    </settings.openInLightbox>
                </el>
            </ROOT>
        </sDEF>
    </sheets>
</T3DataStructure>
