<?xml version="1.0" encoding="UTF-8"?>
<T3DataStructure>
    <sheets>
        <sDEF>
            <ROOT>
                <sheetTitle>Style</sheetTitle>
                <type>array</type>
                <el>
                    <settings.style>
                        <label>Style</label>
                        <onChange>reload</onChange>
                        <config>
                            <type>select</type>
                            <renderType>selectSingle</renderType>
                            <default>info</default>
                            <items>
                                <numIndex index="0"><label>Info</label><value>info</value></numIndex>
                                <numIndex index="1"><label>Success</label><value>success</value></numIndex>
                                <numIndex index="2"><label>Warning</label><value>warning</value></numIndex>
                                <numIndex index="3"><label>Danger</label><value>danger</value></numIndex>
                                <numIndex index="4"><label>Custom</label><value>custom</value></numIndex>
                            </items>
                        </config>
                    </settings.style>
                    <settings.icon>
                        <label>Show icon</label>
                        <config>
                            <type>check</type>
                            <renderType>checkboxToggle</renderType>
                            <default>1</default>
                        </config>
                    </settings.icon>
                    <settings.contentAlign>
                        <label>Content alignment</label>
                        <description>Vertical alignment of the icon and text. "Top" (default) keeps the icon aligned with the first line, which reads best once header/subheader/body stack up. "Center" suits a single short line.</description>
                        <config>
                            <type>select</type>
                            <renderType>selectSingle</renderType>
                            <default>start</default>
                            <items>
                                <numIndex index="0"><label>Top</label><value>start</value></numIndex>
                                <numIndex index="1"><label>Center</label><value>center</value></numIndex>
                                <numIndex index="2"><label>Bottom</label><value>end</value></numIndex>
                            </items>
                        </config>
                    </settings.contentAlign>
                </el>
            </ROOT>
        </sDEF>
        <custom>
            <ROOT>
                <sheetTitle>Custom</sheetTitle>
                <type>array</type>
                <el>
                    <settings.customAccentColor>
                        <label>Icon color</label>
                        <description>Color of the custom icon (set on the icon fields further down this tab), only if it's a Bootstrap Icons name, not an image. Only used when Style (Style tab) is set to Custom. For the border, use the Border tab's Border color instead.</description>
                        <config>
                            <type>color</type>
                            <opacity>1</opacity>
                            <displayCond>FIELD:sDEF.settings.style:=:custom</displayCond>
                        </config>
                    </settings.customAccentColor>
                    <settings.customBackgroundColor>
                        <label>Background color</label>
                        <description>Only used when Style (Style tab) is set to Custom.</description>
                        <config>
                            <type>color</type>
                            <opacity>1</opacity>
                            <displayCond>FIELD:sDEF.settings.style:=:custom</displayCond>
                        </config>
                    </settings.customBackgroundColor>
                    <settings.customTextColor>
                        <label>Text color</label>
                        <description>Only used when Style (Style tab) is set to Custom.</description>
                        <config>
                            <type>color</type>
                            <opacity>1</opacity>
                            <displayCond>FIELD:sDEF.settings.style:=:custom</displayCond>
                        </config>
                    </settings.customTextColor>
                </el>
            </ROOT>
        </custom>
        <border>
            <ROOT>
                <sheetTitle>Border</sheetTitle>
                <type>array</type>
                <el>
                    <settings.borderColor>
                        <label>Border color</label>
                        <description>Leave empty to use the style's default border color. Supports opacity.</description>
                        <config>
                            <type>color</type>
                            <opacity>1</opacity>
                        </config>
                    </settings.borderColor>
                    <settings.borderRadius>
                        <label>Border radius</label>
                        <config>
                            <type>select</type>
                            <renderType>selectSingle</renderType>
                            <default>theme</default>
                            <itemsProcFunc>Connetation\T3wtkBase\Utility\RadiusOptions->addItems</itemsProcFunc>
                        </config>
                    </settings.borderRadius>
                </el>
            </ROOT>
        </border>
        <position>
            <ROOT>
                <sheetTitle>Position</sheetTitle>
                <type>array</type>
                <el>
                    <settings.position>
                        <label>Position</label>
                        <description>"Inline" places the alert in the normal page flow. The others pin it to a screen edge, ignoring scroll: Top/Bottom as a full-width bar, Left/Right edge as a small button that expands into the full alert on click.</description>
                        <onChange>reload</onChange>
                        <config>
                            <type>select</type>
                            <renderType>selectSingle</renderType>
                            <default>static</default>
                            <items>
                                <numIndex index="0"><label>Inline (in page content)</label><value>static</value></numIndex>
                                <numIndex index="1"><label>Fixed — Top (full width)</label><value>fixed-top</value></numIndex>
                                <numIndex index="2"><label>Fixed — Bottom (full width)</label><value>fixed-bottom</value></numIndex>
                                <numIndex index="3"><label>Fixed — Left edge (button)</label><value>edge-left</value></numIndex>
                                <numIndex index="4"><label>Fixed — Right edge (button)</label><value>edge-right</value></numIndex>
                            </items>
                        </config>
                    </settings.position>
                    <settings.verticalAlign>
                        <label>Vertical position</label>
                        <description>Where the button sits along the edge.</description>
                        <config>
                            <type>select</type>
                            <renderType>selectSingle</renderType>
                            <default>center</default>
                            <displayCond>FIELD:settings.position:IN:edge-left,edge-right</displayCond>
                            <items>
                                <numIndex index="0"><label>Top</label><value>top</value></numIndex>
                                <numIndex index="1"><label>Center</label><value>center</value></numIndex>
                                <numIndex index="2"><label>Bottom</label><value>bottom</value></numIndex>
                            </items>
                        </config>
                    </settings.verticalAlign>
                    <settings.buttonShape>
                        <label>Button shape</label>
                        <config>
                            <type>select</type>
                            <renderType>selectSingle</renderType>
                            <default>circle</default>
                            <displayCond>FIELD:settings.position:IN:edge-left,edge-right</displayCond>
                            <items>
                                <numIndex index="0"><label>Circle</label><value>circle</value></numIndex>
                                <numIndex index="1"><label>Square</label><value>square</value></numIndex>
                            </items>
                        </config>
                    </settings.buttonShape>
                    <settings.buttonColor>
                        <label>Button color</label>
                        <description>Background of the collapsed edge button. Leave empty to use the style's default (Accent/Background color for Custom, the theme color otherwise). Independent from the Text/Accent colors above.</description>
                        <config>
                            <type>color</type>
                            <opacity>1</opacity>
                            <displayCond>FIELD:settings.position:IN:edge-left,edge-right</displayCond>
                        </config>
                    </settings.buttonColor>
                    <settings.buttonTextColor>
                        <label>Button icon color</label>
                        <description>Icon color of the collapsed edge button. Leave empty to use the style's default. Independent from the alert's own Text color.</description>
                        <config>
                            <type>color</type>
                            <opacity>1</opacity>
                            <displayCond>FIELD:settings.position:IN:edge-left,edge-right</displayCond>
                        </config>
                    </settings.buttonTextColor>
                    <settings.pushContent>
                        <label>Avoid the navigation</label>
                        <description>On: a Top bar sits below the navigation instead of covering it, and a Bottom bar reserves room so it doesn't cover the footer once scrolled all the way down. Off: the bar floats over the page instead, ignoring the navigation too — e.g. to deliberately show something important over it. Only applies to Top/Bottom.</description>
                        <config>
                            <type>check</type>
                            <renderType>checkboxToggle</renderType>
                            <default>1</default>
                            <displayCond>FIELD:settings.position:IN:fixed-top,fixed-bottom</displayCond>
                        </config>
                    </settings.pushContent>
                </el>
            </ROOT>
        </position>
        <dismiss>
            <ROOT>
                <sheetTitle>Dismiss</sheetTitle>
                <type>array</type>
                <el>
                    <settings.dismissible>
                        <label>Dismissible</label>
                        <onChange>reload</onChange>
                        <config>
                            <type>check</type>
                            <renderType>checkboxToggle</renderType>
                            <default>0</default>
                        </config>
                    </settings.dismissible>
                    <settings.closeColor>
                        <label>Close (×) button color</label>
                        <description>Leave empty to use the theme default. Only shown when Dismissible is on.</description>
                        <config>
                            <type>color</type>
                            <opacity>1</opacity>
                            <displayCond>FIELD:settings.dismissible:=:1</displayCond>
                        </config>
                    </settings.closeColor>
                    <settings.rememberDismiss>
                        <label>Remember dismissal</label>
                        <description>On: once a visitor closes this alert, it stays closed for them (stored in their browser) instead of reappearing on the next page load. Editing this alert's text/settings and saving resets it for everyone, since that changes what there is to see.</description>
                        <config>
                            <type>check</type>
                            <renderType>checkboxToggle</renderType>
                            <default>0</default>
                            <displayCond>FIELD:settings.dismissible:=:1</displayCond>
                        </config>
                    </settings.rememberDismiss>
                </el>
            </ROOT>
        </dismiss>
    </sheets>
</T3DataStructure>
