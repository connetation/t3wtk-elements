<?xml version="1.0" encoding="UTF-8"?>
<T3DataStructure>
    <sheets>
        <sDEF>
            <ROOT>
                <sheetTitle>Display</sheetTitle>
                <type>array</type>
                <el>
                    <settings.slides_per_view>
                        <label>Slides visible at once (desktop)</label>
                        <config>
                            <type>select</type>
                            <renderType>selectSingle</renderType>
                            <default>3</default>
                            <items>
                                <numIndex index="0"><label>1</label><value>1</value></numIndex>
                                <numIndex index="1"><label>2</label><value>2</value></numIndex>
                                <numIndex index="2"><label>3 (default)</label><value>3</value></numIndex>
                                <numIndex index="3"><label>4</label><value>4</value></numIndex>
                            </items>
                        </config>
                    </settings.slides_per_view>
                    <settings.loop>
                        <label>Loop (infinite)</label>
                        <config>
                            <type>check</type>
                            <renderType>checkboxToggle</renderType>
                            <default>1</default>
                        </config>
                    </settings.loop>
                    <settings.autoplay>
                        <label>Autoplay</label>
                        <config>
                            <type>check</type>
                            <renderType>checkboxToggle</renderType>
                            <default>0</default>
                        </config>
                    </settings.autoplay>
                    <settings.autoplay_delay>
                        <label>Autoplay delay</label>
                        <config>
                            <type>select</type>
                            <renderType>selectSingle</renderType>
                            <default>4000</default>
                            <items>
                                <numIndex index="0"><label>3 seconds</label><value>3000</value></numIndex>
                                <numIndex index="1"><label>4 seconds (default)</label><value>4000</value></numIndex>
                                <numIndex index="2"><label>5 seconds</label><value>5000</value></numIndex>
                                <numIndex index="3"><label>7 seconds</label><value>7000</value></numIndex>
                            </items>
                        </config>
                    </settings.autoplay_delay>
                    <settings.show_navigation>
                        <label>Show prev/next arrows</label>
                        <config>
                            <type>check</type>
                            <renderType>checkboxToggle</renderType>
                            <default>1</default>
                        </config>
                    </settings.show_navigation>
                    <settings.show_pagination>
                        <label>Show pagination dots</label>
                        <config>
                            <type>check</type>
                            <renderType>checkboxToggle</renderType>
                            <default>1</default>
                        </config>
                    </settings.show_pagination>
                </el>
            </ROOT>
        </sDEF>
    </sheets>
</T3DataStructure>
