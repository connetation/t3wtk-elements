<?xml version="1.0" encoding="UTF-8"?>
<T3DataStructure>
    <sheets>
        <sDEF>
            <ROOT>
                <sheetTitle>Display</sheetTitle>
                <type>array</type>
                <el>
                    <settings.slides_per_view>
                        <label>Slides visible at once</label>
                        <config>
                            <type>input</type>
                            <renderType>connResponsiveRange</renderType>
                            <responsive>
                                <lower>1</lower>
                                <upper>4</upper>
                                <step>1</step>
                                <auto>1</auto>
                            </responsive>
                            <default>3</default>
                        </config>
                    </settings.slides_per_view>
                    <settings.loop>
                        <label>Loop (infinite)</label>
                        <config>
                            <type>check</type>
                            <renderType>checkboxToggle</renderType>
                            <default>1</default>
                        </config>
                    </settings.loop>
                    <settings.autoplay>
                        <label>Autoplay</label>
                        <config>
                            <type>check</type>
                            <renderType>checkboxToggle</renderType>
                            <default>0</default>
                        </config>
                    </settings.autoplay>
                    <settings.autoplay_delay>
                        <label>Autoplay delay</label>
                        <config>
                            <type>select</type>
                            <renderType>selectSingle</renderType>
                            <default>4000</default>
                            <items>
                                <numIndex index="0"><label>3 seconds</label><value>3000</value></numIndex>
                                <numIndex index="1"><label>4 seconds (default)</label><value>4000</value></numIndex>
                                <numIndex index="2"><label>5 seconds</label><value>5000</value></numIndex>
                                <numIndex index="3"><label>7 seconds</label><value>7000</value></numIndex>
                            </items>
                        </config>
                    </settings.autoplay_delay>
                    <settings.show_navigation>
                        <label>Show prev/next arrows</label>
                        <onChange>reload</onChange>
                        <config>
                            <type>check</type>
                            <renderType>checkboxToggle</renderType>
                            <default>1</default>
                        </config>
                    </settings.show_navigation>
                    <settings.hide_navigation_mobile>
                        <label>Hide arrows on mobile</label>
                        <displayCond>FIELD:settings.show_navigation:=:1</displayCond>
                        <config>
                            <type>check</type>
                            <renderType>checkboxToggle</renderType>
                            <default>0</default>
                        </config>
                    </settings.hide_navigation_mobile>
                    <settings.show_pagination>
                        <label>Show pagination dots</label>
                        <onChange>reload</onChange>
                        <config>
                            <type>check</type>
                            <renderType>checkboxToggle</renderType>
                            <default>1</default>
                        </config>
                    </settings.show_pagination>
                    <settings.hide_pagination_mobile>
                        <label>Hide pagination dots on mobile</label>
                        <displayCond>FIELD:settings.show_pagination:=:1</displayCond>
                        <config>
                            <type>check</type>
                            <renderType>checkboxToggle</renderType>
                            <default>0</default>
                        </config>
                    </settings.hide_pagination_mobile>
                </el>
            </ROOT>
        </sDEF>
        <cardDesign>FILE:EXT:conn_t3wtk_elements/Configuration/FlexForms/Shared/CardDesign.xml</cardDesign>
        <typography>FILE:EXT:conn_t3wtk_elements/Configuration/FlexForms/Shared/CardTypography.xml</typography>
    </sheets>
</T3DataStructure>
