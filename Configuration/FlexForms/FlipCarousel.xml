<?xml version="1.0" encoding="UTF-8"?>
<T3DataStructure>
    <sheets>
        <sDEF>
            <ROOT>
                <sheetTitle>Display</sheetTitle>
                <type>array</type>
                <el>
                    <settings.columns>
                        <label>Visible items</label>
                        <config>
                            <type>select</type>
                            <renderType>selectSingle</renderType>
                            <default>4</default>
                            <items>
                                <numIndex index="0"><label>2 items</label><value>2</value></numIndex>
                                <numIndex index="1"><label>3 items</label><value>3</value></numIndex>
                                <numIndex index="2"><label>4 items (default)</label><value>4</value></numIndex>
                            </items>
                        </config>
                    </settings.columns>
                    <settings.textPosition>
                        <label>Text Position</label>
                        <config>
                            <type>select</type>
                            <renderType>selectSingle</renderType>
                            <default>bottom</default>
                            <items>
                                <numIndex index="0"><label>Bottom (default)</label><value>bottom</value></numIndex>
                                <numIndex index="1"><label>Center</label><value>center</value></numIndex>
                                <numIndex index="2"><label>Top</label><value>top</value></numIndex>
                            </items>
                        </config>
                    </settings.textPosition>
                    <settings.textAlign>
                        <label>Text Alignment</label>
                        <config>
                            <type>select</type>
                            <renderType>selectSingle</renderType>
                            <default>left</default>
                            <items>
                                <numIndex index="0"><label>Left (default)</label><value>left</value></numIndex>
                                <numIndex index="1"><label>Center</label><value>center</value></numIndex>
                                <numIndex index="2"><label>Right</label><value>right</value></numIndex>
                            </items>
                        </config>
                    </settings.textAlign>
                </el>
            </ROOT>
        </sDEF>
    </sheets>
</T3DataStructure>
