<?xml version="1.0" encoding="UTF-8"?>
<T3DataStructure>
    <sheets>
        <sDEF>
            <ROOT>
                <sheetTitle>Display</sheetTitle>
                <type>array</type>
                <el>
                    <settings.layout>
                        <label>Layout</label>
                        <config>
                            <type>select</type>
                            <renderType>selectSingle</renderType>
                            <default>grid</default>
                            <items>
                                <numIndex index="0"><label>Grid</label><value>grid</value></numIndex>
                                <numIndex index="1"><label>Marquee (scrolling strip)</label><value>marquee</value></numIndex>
                            </items>
                        </config>
                    </settings.layout>
                    <settings.columns>
                        <label>Logos per row (Grid only)</label>
                        <config>
                            <type>select</type>
                            <renderType>selectSingle</renderType>
                            <default>5</default>
                            <items>
                                <numIndex index="0"><label>3 columns</label><value>3</value></numIndex>
                                <numIndex index="1"><label>4 columns</label><value>4</value></numIndex>
                                <numIndex index="2"><label>5 columns (default)</label><value>5</value></numIndex>
                                <numIndex index="3"><label>6 columns</label><value>6</value></numIndex>
                            </items>
                        </config>
                    </settings.columns>
                    <settings.speed>
                        <label>Marquee speed (seconds per cycle)</label>
                        <config>
                            <type>input</type>
                            <size>5</size>
                            <default>30</default>
                            <placeholder>30</placeholder>
                        </config>
                    </settings.speed>
                    <settings.direction>
                        <label>Marquee scroll direction (Marquee only)</label>
                        <config>
                            <type>select</type>
                            <renderType>selectSingle</renderType>
                            <default>left</default>
                            <items>
                                <numIndex index="0"><label>To the left (default)</label><value>left</value></numIndex>
                                <numIndex index="1"><label>To the right</label><value>right</value></numIndex>
                            </items>
                        </config>
                    </settings.direction>
                    <settings.accentBar>
                        <label>Accent bar on hover (Grid only)</label>
                        <config>
                            <type>check</type>
                            <renderType>checkboxToggle</renderType>
                            <default>1</default>
                        </config>
                    </settings.accentBar>
                    <settings.grayscale>
                        <label>Show logos in grayscale</label>
                        <config>
                            <type>check</type>
                            <renderType>checkboxToggle</renderType>
                            <items>
                                <numIndex index="0"><label></label></numIndex>
                            </items>
                            <default>1</default>
                        </config>
                    </settings.grayscale>
                </el>
            </ROOT>
        </sDEF>
    </sheets>
</T3DataStructure>
