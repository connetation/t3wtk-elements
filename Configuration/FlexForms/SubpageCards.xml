<?xml version="1.0" encoding="UTF-8"?>
<T3DataStructure>
    <sheets>
        <sDEF>
            <ROOT>
                <sheetTitle>Display</sheetTitle>
                <type>array</type>
                <el>
                    <settings.columns>
                        <label>Cards per row</label>
                        <config>
                            <type>input</type>
                            <renderType>connResponsiveRange</renderType>
                            <responsive>
                                <lower>1</lower>
                                <upper>4</upper>
                                <step>1</step>
                                <auto>1</auto>
                            </responsive>
                            <default>3</default>
                        </config>
                    </settings.columns>
                    <settings.cardAlign>
                        <label>LLL:EXT:conn_t3wtk_base/Resources/Private/Language/locallang_be.xlf:card_align</label>
                        <description>LLL:EXT:conn_t3wtk_base/Resources/Private/Language/locallang_be.xlf:card_align.description</description>
                        <config>
                            <type>select</type>
                            <renderType>selectSingle</renderType>
                            <items type="array"></items>
                            <itemsProcFunc>Connetation\T3wtkBase\Utility\CardAlignOptions->addItems</itemsProcFunc>
                            <default>start</default>
                        </config>
                    </settings.cardAlign>
                    <settings.style>
                        <label>Card style</label>
                        <config>
                            <type>select</type>
                            <renderType>selectSingle</renderType>
                            <default>default</default>
                            <items>
                                <numIndex index="0"><label>Default (bordered)</label><value>default</value></numIndex>
                                <numIndex index="1"><label>Shadow</label><value>shadow</value></numIndex>
                                <numIndex index="2"><label>Flat (no border)</label><value>flat</value></numIndex>
                            </items>
                        </config>
                    </settings.style>
                    <settings.accentBar>
                        <label>Accent bar on hover</label>
                        <config>
                            <type>check</type>
                            <renderType>checkboxToggle</renderType>
                            <default>1</default>
                        </config>
                    </settings.accentBar>
                    <settings.cardBorderColor>
                        <label>Card border color (empty = theme default)</label>
                        <config>
                            <type>color</type>
                            <opacity>1</opacity>
                            <default></default>
                        </config>
                    </settings.cardBorderColor>
                    <settings.cardBorderRadius>
                        <label>Card border radius</label>
                        <config>
                            <type>select</type>
                            <renderType>selectSingle</renderType>
                            <default>theme</default>
                            <itemsProcFunc>Connetation\T3wtkBase\Utility\RadiusOptions->addItems</itemsProcFunc>
                        </config>
                    </settings.cardBorderRadius>
                    <settings.titleTag>
                        <label>Card title heading level</label>
                        <config>
                            <type>select</type>
                            <renderType>selectSingle</renderType>
                            <default>h3</default>
                            <items>
                                <numIndex index="0"><label>H2</label><value>h2</value></numIndex>
                                <numIndex index="1"><label>H3 (default)</label><value>h3</value></numIndex>
                                <numIndex index="2"><label>H4</label><value>h4</value></numIndex>
                                <numIndex index="3"><label>H5</label><value>h5</value></numIndex>
                                <numIndex index="4"><label>Paragraph</label><value>p</value></numIndex>
                            </items>
                        </config>
                    </settings.titleTag>
                    <settings.titleAlign>
                        <label>Title alignment</label>
                        <config>
                            <type>select</type>
                            <renderType>selectSingle</renderType>
                            <default>start</default>
                            <items>
                                <numIndex index="0"><label>Left</label><value>start</value></numIndex>
                                <numIndex index="1"><label>Center</label><value>center</value></numIndex>
                                <numIndex index="2"><label>Right</label><value>end</value></numIndex>
                            </items>
                        </config>
                    </settings.titleAlign>
                    <settings.bodyAlign>
                        <label>Teaser alignment</label>
                        <config>
                            <type>select</type>
                            <renderType>selectSingle</renderType>
                            <default>start</default>
                            <items>
                                <numIndex index="0"><label>Left</label><value>start</value></numIndex>
                                <numIndex index="1"><label>Center</label><value>center</value></numIndex>
                                <numIndex index="2"><label>Right</label><value>end</value></numIndex>
                            </items>
                        </config>
                    </settings.bodyAlign>
                    <settings.linkAlign>
                        <label>Link button alignment</label>
                        <config>
                            <type>select</type>
                            <renderType>selectSingle</renderType>
                            <default>start</default>
                            <items>
                                <numIndex index="0"><label>Left</label><value>start</value></numIndex>
                                <numIndex index="1"><label>Center</label><value>center</value></numIndex>
                                <numIndex index="2"><label>Right</label><value>end</value></numIndex>
                            </items>
                        </config>
                    </settings.linkAlign>
                </el>
            </ROOT>
        </sDEF>
        <sContent>
            <ROOT>
                <sheetTitle>Card content</sheetTitle>
                <type>array</type>
                <el>
                    <settings.showImage>
                        <label>Show image</label>
                        <config>
                            <type>check</type>
                            <renderType>checkboxToggle</renderType>
                            <default>1</default>
                        </config>
                    </settings.showImage>
                    <settings.showPlaceholder>
                        <label>Show placeholder when a page has no image</label>
                        <config>
                            <type>check</type>
                            <renderType>checkboxToggle</renderType>
                            <default>0</default>
                        </config>
                    </settings.showPlaceholder>
                    <settings.showSubtitle>
                        <label>Show subtitle (page "Card subtitle", else the page subtitle)</label>
                        <config>
                            <type>check</type>
                            <renderType>checkboxToggle</renderType>
                            <default>1</default>
                        </config>
                    </settings.showSubtitle>
                    <settings.subtitleEyebrow>
                        <label>Subtitle as eyebrow (small uppercase label above the title)</label>
                        <displayCond>FIELD:settings.showSubtitle:REQ:true</displayCond>
                        <config>
                            <type>check</type>
                            <renderType>checkboxToggle</renderType>
                            <default>0</default>
                        </config>
                    </settings.subtitleEyebrow>
                    <settings.eyebrowPosition>
                        <label>Eyebrow position</label>
                        <displayCond>FIELD:settings.subtitleEyebrow:REQ:true</displayCond>
                        <config>
                            <type>select</type>
                            <renderType>selectSingle</renderType>
                            <items>
                                <numIndex index="0"><label>Auto (same as title alignment)</label><value>auto</value></numIndex>
                                <numIndex index="1"><label>Left</label><value>start</value></numIndex>
                                <numIndex index="2"><label>Center</label><value>center</value></numIndex>
                                <numIndex index="3"><label>Right</label><value>end</value></numIndex>
                            </items>
                            <default>auto</default>
                        </config>
                    </settings.eyebrowPosition>
                    <settings.showTeaser>
                        <label>Show teaser text</label>
                        <config>
                            <type>check</type>
                            <renderType>checkboxToggle</renderType>
                            <default>1</default>
                        </config>
                    </settings.showTeaser>
                    <settings.cropMaxCharacters>
                        <label>Crop teaser after x characters (0 = no cropping)</label>
                        <config>
                            <type>number</type>
                            <size>5</size>
                            <default>0</default>
                            <range>
                                <lower>0</lower>
                            </range>
                        </config>
                    </settings.cropMaxCharacters>
                    <settings.showLink>
                        <label>Show link button</label>
                        <config>
                            <type>check</type>
                            <renderType>checkboxToggle</renderType>
                            <default>1</default>
                        </config>
                    </settings.showLink>
                    <settings.linkLabel>
                        <label>Link button label (empty = "More")</label>
                        <config>
                            <type>input</type>
                            <size>30</size>
                            <default></default>
                        </config>
                    </settings.linkLabel>
                </el>
            </ROOT>
        </sContent>
        <sPages>
            <ROOT>
                <sheetTitle>Pages</sheetTitle>
                <type>array</type>
                <el>
                    <settings.orderBy>
                        <label>Order</label>
                        <config>
                            <type>select</type>
                            <renderType>selectSingle</renderType>
                            <default>sorting</default>
                            <items>
                                <numIndex index="0"><label>Page tree order / order of selection (default)</label><value>sorting</value></numIndex>
                                <numIndex index="1"><label>Title (A–Z)</label><value>title</value></numIndex>
                                <numIndex index="2"><label>Newest first</label><value>crdate</value></numIndex>
                                <numIndex index="3"><label>Last updated first</label><value>lastUpdated</value></numIndex>
                            </items>
                        </config>
                    </settings.orderBy>
                    <settings.maxItems>
                        <label>Maximum number of cards (0 = all)</label>
                        <config>
                            <type>number</type>
                            <size>5</size>
                            <default>0</default>
                            <range>
                                <lower>0</lower>
                            </range>
                        </config>
                    </settings.maxItems>
                    <settings.includeNavHide>
                        <label>Include pages hidden in menus</label>
                        <config>
                            <type>check</type>
                            <renderType>checkboxToggle</renderType>
                            <default>0</default>
                        </config>
                    </settings.includeNavHide>
                </el>
            </ROOT>
        </sPages>
        <cardDesign>FILE:EXT:conn_t3wtk_elements/Configuration/FlexForms/Shared/CardDesign.xml</cardDesign>
        <typography>FILE:EXT:conn_t3wtk_elements/Configuration/FlexForms/Shared/CardTypography.xml</typography>
    </sheets>
</T3DataStructure>
