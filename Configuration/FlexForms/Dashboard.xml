<?xml version="1.0" encoding="UTF-8"?>
<T3DataStructure>
    <sheets>
        <sDEF>
            <ROOT>
                <sheetTitle>Display</sheetTitle>
                <type>array</type>
                <el>
                    <settings.defaultView>
                        <label>Default View</label>
                        <config>
                            <type>select</type>
                            <renderType>selectSingle</renderType>
                            <default>grid</default>
                            <items>
                                <numIndex index="0"><label>Grid</label><value>grid</value></numIndex>
                                <numIndex index="1"><label>List</label><value>list</value></numIndex>
                                <numIndex index="2"><label>Compact</label><value>compact</value></numIndex>
                            </items>
                        </config>
                    </settings.defaultView>
                    <settings.columns>
                        <label>Grid Columns</label>
                        <displayCond>FIELD:settings.defaultView:=:grid</displayCond>
                        <config>
                            <type>select</type>
                            <renderType>selectSingle</renderType>
                            <default>3</default>
                            <items>
                                <numIndex index="0"><label>2 Columns</label><value>2</value></numIndex>
                                <numIndex index="1"><label>3 Columns</label><value>3</value></numIndex>
                                <numIndex index="2"><label>4 Columns</label><value>4</value></numIndex>
                            </items>
                        </config>
                    </settings.columns>
                    <settings.cardVariant>
                        <label>Card style</label>
                        <displayCond>FIELD:settings.defaultView:=:grid</displayCond>
                        <config>
                            <type>select</type>
                            <renderType>selectSingle</renderType>
                            <default>image-top</default>
                            <items>
                                <numIndex index="0"><label>Image top (default)</label><value>image-top</value></numIndex>
                                <numIndex index="1"><label>Image left (horizontal)</label><value>image-left</value></numIndex>
                                <numIndex index="2"><label>No image (text only)</label><value>no-image</value></numIndex>
                                <numIndex index="3"><label>Logo only (minimal)</label><value>logo-only</value></numIndex>
                            </items>
                        </config>
                    </settings.cardVariant>
                    <settings.compactColumns>
                        <label>Compact columns per row</label>
                        <displayCond>FIELD:settings.defaultView:=:compact</displayCond>
                        <config>
                            <type>select</type>
                            <renderType>selectSingle</renderType>
                            <default>4</default>
                            <items>
                                <numIndex index="0"><label>3 columns</label><value>3</value></numIndex>
                                <numIndex index="1"><label>4 columns (default)</label><value>4</value></numIndex>
                                <numIndex index="2"><label>5 columns</label><value>5</value></numIndex>
                                <numIndex index="3"><label>6 columns</label><value>6</value></numIndex>
                            </items>
                        </config>
                    </settings.compactColumns>
                    <settings.showStats>
                        <label>Show statistics bar</label>
                        <config>
                            <type>check</type>
                            <renderType>checkboxToggle</renderType>
                            <default>1</default>
                        </config>
                    </settings.showStats>
                    <settings.statsStyle>
                        <label>Statistics style</label>
                        <displayCond>FIELD:settings.showStats:=:1</displayCond>
                        <config>
                            <type>select</type>
                            <renderType>selectSingle</renderType>
                            <default>default</default>
                            <items>
                                <numIndex index="0"><label>Default (large cards)</label><value>default</value></numIndex>
                                <numIndex index="1"><label>Compact (small pills)</label><value>compact</value></numIndex>
                            </items>
                        </config>
                    </settings.statsStyle>
                    <settings.showFilter>
                        <label>Show filter controls</label>
                        <config>
                            <type>check</type>
                            <renderType>checkboxToggle</renderType>
                            <default>1</default>
                        </config>
                    </settings.showFilter>
                    <settings.filterStyle>
                        <label>Filter controls style</label>
                        <displayCond>FIELD:settings.showFilter:=:1</displayCond>
                        <config>
                            <type>select</type>
                            <renderType>selectSingle</renderType>
                            <default>default</default>
                            <items>
                                <numIndex index="0"><label>Default</label><value>default</value></numIndex>
                                <numIndex index="1"><label>Compact (icon labels)</label><value>compact</value></numIndex>
                            </items>
                        </config>
                    </settings.filterStyle>
                    <settings.tagsStyle>
                        <label>Tags filter display</label>
                        <displayCond>FIELD:settings.showFilter:=:1</displayCond>
                        <config>
                            <type>select</type>
                            <renderType>selectSingle</renderType>
                            <default>row</default>
                            <items>
                                <numIndex index="0"><label>Tag row (below controls)</label><value>row</value></numIndex>
                                <numIndex index="1"><label>Tags dropdown (in controls bar)</label><value>dropdown</value></numIndex>
                                <numIndex index="2"><label>Hidden</label><value>hidden</value></numIndex>
                            </items>
                        </config>
                    </settings.tagsStyle>
                    <settings.showSearch>
                        <label>Show search input</label>
                        <displayCond>FIELD:settings.showFilter:=:1</displayCond>
                        <config>
                            <type>check</type>
                            <renderType>checkboxToggle</renderType>
                            <default>1</default>
                        </config>
                    </settings.showSearch>
                    <settings.showModal>
                        <label>Open details in modal</label>
                        <config>
                            <type>check</type>
                            <renderType>checkboxToggle</renderType>
                            <default>1</default>
                        </config>
                    </settings.showModal>
                </el>
            </ROOT>
        </sDEF>
    </sheets>
</T3DataStructure>
