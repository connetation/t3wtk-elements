{
  "name": "conn-t3wtk-elements",
  "version": "1.0.0",
  "description": "Connetation Elements – TYPO3 LTS 14 build tooling",
  "private": true,
  "scripts": {
    "build": "npm run build:swiper-css && npm run build:scss && npm run build:js",
    "build:swiper-css": "cp node_modules/swiper/swiper-bundle.min.css Resources/Public/Css/swiper.css",
    "build:scss": "node build-scss.mjs",
    "build:js": "node build.mjs",
    "dev": "npm run dev:scss & npm run dev:js",
    "dev:scss": "node build-scss.mjs --watch",
    "dev:js": "node build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "make-element": "node bin/make-element.mjs",
    "postinstall": "npm rebuild esbuild"
  },
  "devDependencies": {
    "@fortawesome/fontawesome-free": "^7.3.0",
    "esbuild": "^0.28.2",
    "gsap": "^3.15.0",
    "ionicons": "^8.0.13",
    "sass": "^1.77.0",
    "swiper": "^12.1.4",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "bootstrap-icons": "^1.13.1"
  }
}
