{
    "name": "connetation/t3wtk-elements",
    "description": "30+ ready-to-use content elements for TYPO3 14 LTS: sliders, galleries, accordions, tabs, timelines, pricing tables, testimonials, team, maps and more. Part of the Connetation TYPO3 Web Toolkit (T3WTK).",
    "keywords": ["TYPO3", "TYPO3 CMS", "extension", "t3wtk", "toolkit", "sitepackage", "theme", "design system", "content elements", "bootstrap", "site sets", "dark mode"],
    "type": "typo3-cms-extension",
    "license": "GPL-2.0-or-later",
    "homepage": "https://github.com/connetation/t3wtk-elements",
    "support": {
        "issues": "https://github.com/connetation/t3wtk-elements/issues",
        "source": "https://github.com/connetation/t3wtk-elements"
    },
    "authors": [
        {
            "name": "Connetation Web Engineering GmbH",
            "email": "office@connetation.at",
            "homepage": "https://www.connetation.at/"
        }
    ],
    "require": {
        "b13/container": "^3.2",
        "typo3/cms-core": "^14.0",
        "typo3/cms-fluid": "^14.0",
        "typo3/cms-frontend": "^14.0",
        "connetation/t3wtk-base": "^3.1.10"
    },
    "replace": {
        "conn/t3kit-elements": "self.version"
    },
    "autoload": {
        "psr-4": {
            "Connetation\\T3wtkElements\\": "Classes/"
        }
    },
    "extra": {
        "typo3/cms": {
            "extension-key": "conn_t3wtk_elements"
        }
    }
}
